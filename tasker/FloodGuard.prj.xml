<?xml version="1.0" encoding="UTF-8"?>
<TaskerData sr="" dvi="1" tv="6.0.5">
  <!-- Task: FloodGuard -->
  <Task sr="task1">
    <cdate>0</cdate>
    <edate>0</edate>
    <id>1</id>
    <nme>FloodGuard</nme>
    <Action sr="act0">
      <code>548</code>  <!-- Variable Add -->
      <Str sr="arg0" ve="str">%flood_count</Str>
      <Int sr="arg1" val="1"/>
    </Action>
    <Action sr="act1">
      <code>547</code>  <!-- Variable Set -->
      <Str sr="arg0" ve="str">%flood_sender</Str>
      <Str sr="arg1" ve="str">%SMSRF</Str>
    </Action>
    <Action sr="act2">
      <code>547</code>
      <Str sr="arg0" ve="str">%flood_last_time</Str>
      <Str sr="arg1" ve="str">%TIMEMS</Str>
    </Action>
    <Action sr="act3">
      <code>37</code>   <!-- If -->
      <Str sr="arg0" ve="str">%flood_count &gt; 12</Str>
    </Action>
    <Action sr="act4">
      <code>130</code>  <!-- Notify -->
      <Str sr="arg0" ve="str">FLOOD DETECTED</Str>
      <Str sr="arg1" ve="str">Blocking %flood_sender</Str>
    </Action>
    <!-- AutoNotification block + DND actions vary by plugin version;
         add them in the Tasker GUI and re-export. -->
    <Action sr="act5">
      <code>37</code>   <!-- If (block via AutoNotification) -->
    </Action>
    <Action sr="act6">
      <code>547</code>
      <Str sr="arg0" ve="str">%flood_count</Str>
      <Str sr="arg1" ve="str">0</Str>
    </Action>
    <Action sr="act7">
      <code>37</code>   <!-- End If -->
    </Action>
  </Task>

  <!-- Profile: Trigger on received text -->
  <Profile sr="prof1">
    <cdate>0</cdate>
    <edate>0</edate>
    <flags>0</flags>
    <id>1</id>
    <nme>InboundSMS</nme>
    <Event sr="type0" ve="2">
      <code>7</code> <!-- Received Text -->
      <Str sr="arg0" ve="str"/>
    </Event>
    <Task sr="task1"/>
  </Profile>
</TaskerData>
